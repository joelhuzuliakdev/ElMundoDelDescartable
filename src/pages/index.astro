---
import Layout from '../layouts/Layout.astro';
import { productos, categorias } from '../data/productos.js';

const destacados = productos.slice(0, 8);

const resenas = [
	{ nombre: "María González", negocio: "Restaurante El Fogón", texto: "Excelente calidad y atención. Los vasos y platos son perfectos para mi restaurante. Siempre me responden rápido por WhatsApp.", estrellas: 5, inicial: "M" },
	{ nombre: "Carlos Pérez", negocio: "Catering Eventos", texto: "Llevo más de 2 años comprando acá. Los precios por mayor son imbatibles y el packaging para delivery es de primera.", estrellas: 5, inicial: "C" },
	{ nombre: "Laura Sánchez", negocio: "Kiosco La Esquina", texto: "Siempre tienen stock de lo que necesito. Las bolsas y cubiertos son excelentes. Muy recomendable para negocios chicos.", estrellas: 5, inicial: "L" },
	{ nombre: "Diego Romero", negocio: "Pizzería Don Diego", texto: "El packaging para pizza y delivery es de muy buena calidad. Lo mejor es que se adaptan a las cantidades que pido.", estrellas: 4, inicial: "D" },
	{ nombre: "Ana Torres", negocio: "Salón de fiestas", texto: "Compro todo lo de descartable para mis eventos acá. Precios accesibles, buena calidad y envíos puntuales.", estrellas: 5, inicial: "A" },
	{ nombre: "Martín López", negocio: "Food Truck", texto: "Increíble variedad. En un solo pedido consigo todo: cajas, vasos, cubiertos y servilletas. Muy cómodo trabajar así.", estrellas: 5, inicial: "M" },
];

const galeria = [
	{ emoji: "🥤", label: "Vasos y bebidas", color: "from-blue-50 to-blue-100", border: "border-blue-200" },
	{ emoji: "🍽️", label: "Platos y bandejas", color: "from-green-50 to-green-100", border: "border-green-200" },
	{ emoji: "📦", label: "Packaging delivery", color: "from-amber-50 to-amber-100", border: "border-amber-200" },
	{ emoji: "🛍️", label: "Bolsas y packaging", color: "from-pink-50 to-pink-100", border: "border-pink-200" },
	{ emoji: "🍴", label: "Cubiertos descartables", color: "from-violet-50 to-violet-100", border: "border-violet-200" },
	{ emoji: "🧻", label: "Servilletas y papel", color: "from-sky-50 to-sky-100", border: "border-sky-200" },
];

const catEmojis: Record<string, string> = {
	"Vasos": "🥤",
	"Platos y bandejas": "🍽️",
	"Cubiertos": "🍴",
	"Bolsas": "🛍️",
	"Packaging": "📦",
	"Higiene": "🧴",
	"Servilletas y papel": "🧻",
	"Eventos": "🎉"
};
---

<Layout
	title="El Mundo del Descartable | Productos Plásticos y Descartables al Mejor Precio"
	description="El Mundo Del Descartable — Productos descartables por mayor y menor. Vasos, platos, cubiertos, bolsas y más. Calidad garantizada con los mejores precios del mercado. Envíos a todo el país."
>

	<!-- ══════════ HERO ══════════ -->
	<section class="relative min-h-[100vh] flex items-center overflow-hidden">

		<!-- Background con imagen del local -->
		<div class="absolute inset-0 z-0">
			<div class="absolute inset-0 bg-gradient-to-br from-blue-950/80 via-blue-900/75 to-teal-900/70 z-10"></div>
			<img
				src="/nosotros/localPorFuera.webp"
				alt="El Mundo del Descartable"
				class="w-full h-full object-cover object-center"
			/>
		</div>

		<!-- Decoración geométrica -->
		<div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-blue-400/10 blur-3xl z-10 pointer-events-none"></div>
		<div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-teal-400/10 blur-3xl z-10 pointer-events-none"></div>

		<div class="container mx-auto px-4 relative z-20 py-20 lg:py-28">
			<div class="max-w-2xl">

				<!-- Badge -->
				<div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white text-xs font-semibold px-4 py-2 rounded-full mb-6 animate-fade-in">
					<span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
					🛒 Venta por mayor y menor
				</div>

				<h1 class="font-extrabold text-white leading-[1.1] mb-5 text-[clamp(2.2rem,5vw,3.6rem)] drop-shadow-lg">
					Todo en descartables<br />
					para tu <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-300 to-teal-300">negocio o evento</span>
				</h1>

				<p class="text-white/75 text-lg font-light mb-8 leading-relaxed max-w-xl">
					Vasos, platos, cubiertos, bolsas, packaging y más. Calidad garantizada con los mejores precios del mercado.
				</p>

				<div class="flex flex-wrap gap-3">
					<a
						href="/productos"
						class="inline-flex items-center gap-2 bg-blue-500 hover:bg-blue-400 text-white font-semibold px-6 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-blue-500/30 hover:shadow-blue-400/40 hover:-translate-y-0.5"
					>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
							<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
							<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
						</svg>
						Ver productos
					</a>
					<button
						onclick="openWP()"
						class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-semibold px-6 py-3.5 rounded-xl border border-white/25 transition-all duration-200 hover:-translate-y-0.5"
					>
						Consultar por WhatsApp
					</button>
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ STATS BAR ══════════ -->
	<div class="bg-blue-600">
		<div class="container mx-auto px-4">
			<div class="flex flex-wrap items-center justify-center divide-x divide-white/20">
				{[
					{ n: "+500", l: "Productos disponibles" },
					{ n: "Mayor y menor", l: "Modalidad de venta" },
					{ n: "Envíos", l: "A todo el país" },
					{ n: "Atención", l: "Personalizada por WP" },
				].map(s => (
					<div class="flex flex-col items-center px-8 py-4">
						<span class="font-extrabold text-white text-lg leading-tight">{s.n}</span>
						<span class="text-blue-200 text-xs mt-0.5">{s.l}</span>
					</div>
				))}
			</div>
		</div>
	</div>

	<!-- ══════════ NOSOTROS ══════════ -->
	<section id="nosotros" class="py-20 bg-white">
		<div class="container mx-auto px-4">
			<div class="grid md:grid-cols-2 gap-14 items-center max-w-6xl mx-auto">

				<!-- Texto -->
				<div>
					<span class="inline-block text-xs font-bold uppercase tracking-widest text-blue-600 mb-3">Quiénes somos</span>
					<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-5 leading-tight">
						Tu aliado en productos <span class="text-blue-600">descartables</span>
					</h2>
					<p class="text-gray-500 mb-4 leading-relaxed">
						En <strong class="text-gray-700">El Mundo del Descartable</strong> ofrecemos soluciones prácticas, económicas y de calidad para negocios, eventos y uso diario.
					</p>
					<p class="text-gray-500 mb-7 leading-relaxed">
						Contamos con una amplia variedad de productos descartables y una atención personalizada que nos convirtió en una opción confiable para nuestros clientes. Rapidez, buenos precios y stock permanente.
					</p>

					<ul class="space-y-3 mb-8">
						{[
							"Gran variedad de productos",
							"Precios competitivos",
							"Atención rápida y personalizada",
							"Ideal para negocios y eventos",
						].map(b => (
							<li class="flex items-center gap-3 text-gray-700 text-sm font-medium">
								<span class="flex-shrink-0 w-5 h-5 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold">✓</span>
								{b}
							</li>
						))}
					</ul>

					<a
						href="/productos"
						class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-xl transition-all duration-200 hover:-translate-y-0.5 shadow-md shadow-blue-200"
					>
						Ver productos →
					</a>
				</div>

				<!-- Video -->
				<div class="relative">
					<div class="absolute -inset-3 bg-gradient-to-br from-blue-100 to-teal-100 rounded-3xl -z-10"></div>
					<video
						src="/video/nosotros.mp4"
						class="rounded-2xl shadow-xl w-full object-cover aspect-video"
						autoplay
						muted
						loop
						playsinline
					></video>
				</div>
			</div>
		</div>
	</section>

	<!-- ══════════ CATEGORÍAS ══════════ -->
	<section id="categorias" class="py-20 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">

			<div class="mb-10">
				<span class="text-xs font-bold uppercase tracking-widest text-blue-600">Catálogo</span>
				<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-1">
					Nuestras <span class="text-blue-600">categorías</span>
				</h2>
				<p class="text-gray-500 text-sm mt-1">Encontrá todo lo que necesitás para tu negocio, evento o uso diario</p>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
				{categorias.filter((c: string) => c !== "Todas").map((cat: string) => {
					const count = productos.filter((p: any) => p.categoria === cat).length;
					return (
						<a
							href={`/productos?cat=${encodeURIComponent(cat)}`}
							class="group bg-white border border-gray-200 hover:border-blue-400 rounded-2xl p-5 flex flex-col items-center gap-2 text-center transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-100"
						>
							<span class="text-4xl">{catEmojis[cat] || "📦"}</span>
							<span class="font-semibold text-sm text-gray-800 group-hover:text-blue-700 transition-colors">{cat}</span>
							<span class="text-xs text-gray-400">{count} producto{count !== 1 ? "s" : ""}</span>
						</a>
					);
				})}
			</div>
		</div>
	</section>

	<!-- ══════════ PRODUCTOS DESTACADOS ══════════ -->
	<section id="destacado" class="py-20 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">

			<div class="flex justify-between items-end flex-wrap gap-4 mb-10">
				<div>
					<span class="text-xs font-bold uppercase tracking-widest text-blue-600">Lo más pedido</span>
					<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-1">
						Productos <span class="text-blue-600">destacados</span>
					</h2>
					<p class="text-gray-500 text-sm mt-1">Los más consultados por nuestros clientes</p>
				</div>
				<a href="/productos" class="text-blue-600 hover:text-blue-800 font-semibold text-sm border border-blue-200 hover:border-blue-400 px-4 py-2 rounded-xl transition-all">
					Ver todos →
				</a>
			</div>

			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
				{destacados.map((p: any) => (
					<div class="group bg-white border border-gray-200 hover:border-blue-300 rounded-2xl overflow-hidden flex flex-col transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-100/60">

						<!-- Imagen -->
						<div class="h-40 bg-gray-50 overflow-hidden flex items-center justify-center">
							<img
								src={p.imagen}
								alt={p.nombre}
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
								onerror="this.parentElement.innerHTML='<span style=\'font-size:64px\'>📦</span>'"
							/>
						</div>

						<!-- Info -->
						<div class="p-4 flex flex-col flex-1">
							<span class="text-[10px] uppercase font-bold tracking-widest text-blue-500 mb-1">{p.categoria}</span>
							<h3 class="font-bold text-gray-900 text-sm leading-snug mb-1">{p.nombre}</h3>
							<p class="text-xs text-gray-400 line-clamp-2 flex-1 mb-3">{p.descripcion}</p>
							<div class="flex items-center justify-between gap-2 mt-auto">
								<div>
									<span class="font-extrabold text-blue-700 text-base">${p.precio.toLocaleString("es-AR")}</span>
									<span class="block text-[10px] text-gray-400">{p.unidad}</span>
								</div>
								<button
									onclick={`cartAgregar(${JSON.stringify(p)})`}
									class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-3 py-2 rounded-lg transition-all hover:scale-105 whitespace-nowrap"
								>
									+ Agregar
								</button>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ GALERÍA / RUBROS ══════════ -->
	<section id="galeria" class="py-20 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">

			<div class="mb-10 text-center">
				<span class="text-xs font-bold uppercase tracking-widest text-blue-600">Lo que encontrás</span>
				<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-1">
					Nuestros <span class="text-blue-600">rubros</span>
				</h2>
				<p class="text-gray-500 text-sm mt-1">Una amplia variedad para cubrir todas tus necesidades</p>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
				{galeria.map(g => (
					<div class={`bg-gradient-to-br ${g.color} border ${g.border} rounded-2xl p-6 flex flex-col items-center gap-3 text-center hover:-translate-y-1 transition-all duration-200 cursor-default`}>
						<span class="text-4xl">{g.emoji}</span>
						<span class="font-semibold text-xs text-gray-700">{g.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ POR QUÉ ELEGIRNOS ══════════ -->
	<section class="py-20 bg-white">
		<div class="container mx-auto px-4 max-w-6xl">

			<div class="text-center mb-12">
				<span class="text-xs font-bold uppercase tracking-widest text-blue-600">Nuestras ventajas</span>
				<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-1">
					¿Por qué <span class="text-blue-600">elegirnos?</span>
				</h2>
				<p class="text-gray-500 text-sm mt-2">Miles de clientes confían en nosotros para sus negocios y eventos</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{[
					{ icon: "🚀", title: "Envíos rápidos", desc: "Despachamos en el día o siguiente hábil. Llegamos a todo el país.", bg: "bg-blue-50", border: "border-blue-100" },
					{ icon: "💰", title: "Precios competitivos", desc: "Los mejores precios del mercado, tanto por mayor como por menor.", bg: "bg-green-50", border: "border-green-100" },
					{ icon: "📦", title: "Gran variedad", desc: "Más de 500 productos disponibles en stock permanente.", bg: "bg-amber-50", border: "border-amber-100" },
					{ icon: "💬", title: "Atención personalizada", desc: "Te asesoramos por WhatsApp para encontrar lo que necesitás.", bg: "bg-pink-50", border: "border-pink-100" },
				].map(w => (
					<div class={`${w.bg} border ${w.border} rounded-2xl p-6 flex flex-col gap-4 hover:-translate-y-1 transition-all duration-200`}>
						<div class="text-3xl">{w.icon}</div>
						<div>
							<h4 class="font-bold text-gray-900 mb-1">{w.title}</h4>
							<p class="text-sm text-gray-500 leading-relaxed">{w.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ RESEÑAS ══════════ -->
	<section class="py-20 bg-gray-50">
		<div class="container mx-auto px-4 max-w-6xl">

			<div class="text-center mb-12">
				<span class="text-xs font-bold uppercase tracking-widest text-blue-600">Testimonios</span>
				<h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mt-1">
					Lo que dicen nuestros <span class="text-blue-600">clientes</span>
				</h2>
				<p class="text-gray-500 text-sm mt-2">Más de 1000 clientes satisfechos en toda la región</p>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
				{resenas.map(r => (
					<div class="bg-white border border-gray-200 hover:border-blue-200 hover:shadow-lg hover:shadow-blue-50 rounded-2xl p-6 flex flex-col gap-4 transition-all duration-200">
						<div class="flex items-center gap-3">
							<div class="w-11 h-11 rounded-full bg-gradient-to-br from-blue-500 to-teal-500 flex items-center justify-center font-extrabold text-white text-base flex-shrink-0">
								{r.inicial}
							</div>
							<div>
								<strong class="block text-sm font-bold text-gray-900">{r.nombre}</strong>
								<span class="text-xs text-gray-400">{r.negocio}</span>
							</div>
						</div>
						<div class="text-amber-400 text-sm tracking-wide">
							{"★".repeat(r.estrellas)}{"☆".repeat(5 - r.estrellas)}
						</div>
						<p class="text-sm text-gray-500 italic leading-relaxed">"{r.texto}"</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ══════════ CTA FINAL ══════════ -->
	<section id="contacto" class="relative py-20 overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-br from-blue-700 via-blue-600 to-teal-600"></div>
		<div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>
		<div class="absolute -bottom-10 -left-10 w-72 h-72 rounded-full bg-teal-400/10 blur-3xl pointer-events-none"></div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="flex flex-col md:flex-row items-center justify-between gap-8 max-w-5xl mx-auto">
				<div class="text-center md:text-left">
					<h2 class="text-3xl md:text-4xl font-extrabold text-white mb-3">¿Necesitás presupuesto?</h2>
					<p class="text-white/70 text-base max-w-md leading-relaxed">
						Escribinos por WhatsApp y te respondemos al instante con precios y disponibilidad. También podés armar tu pedido directo desde el carrito.
					</p>
				</div>
				<div class="flex flex-wrap gap-3 justify-center">
					<button
						onclick="openWP()"
						class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-white font-bold px-7 py-4 rounded-xl transition-all duration-200 shadow-lg shadow-green-600/30 hover:-translate-y-0.5"
					>
						<svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
						</svg>
						Escribinos ahora
					</button>
					<a
						href="/productos"
						class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-semibold px-7 py-4 rounded-xl border border-white/25 transition-all duration-200 hover:-translate-y-0.5"
					>
						Ver catálogo
					</a>
				</div>
			</div>
		</div>
	</section>

</Layout>

<style>
	@keyframes fade-in {
		from { opacity: 0; transform: translateY(10px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in { animation: fade-in 0.6s ease both; }
</style>