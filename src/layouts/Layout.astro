---
// src/layouts/Layout.astro
export interface Props {
	title?: string;
	description?: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content={description} />
	<title>{title}</title>
	<link rel="icon" href="/favicon_pro.ico" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>

<body>

<!-- ═══════════════ NAVBAR ═══════════════ -->
<header class="navbar" id="navbar">
	<div class="nav-inner container">

		<!-- Logo -->
		<a href="/" class="nav-logo">
		<img src="/logoDescartable.webp" alt="El Mundo Del Descartable" loading="lazy" class="logo-img" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
		<div class="logo-text">
			<span class="logo-main">El Mundo</span>
			<span class="logo-sub">Del Descartable</span>
		</div>
		</a>

		<!-- Links desktop -->
		<nav class="nav-links" id="navLinks">
		<a href="/" class="nav-link">Inicio</a>
		<a href="/productos" class="nav-link">Productos</a>
		<a href="/#categorias" class="nav-link">Categorías</a>
		<a href="/#destacado" class="nav-link">Destacado</a>
		<a href="/#contacto" class="nav-link">Contacto</a>
		</nav>

		<!-- Acciones -->
		<div class="nav-actions">

		<!-- Carrito btn -->
		<button class="cart-btn" id="cartBtn" aria-label="Abrir carrito">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
			<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
			</svg>
			<span class="cart-badge" id="cartBadge">0</span>
		</button>

		<!-- Hamburger mobile -->
		<button class="hamburger" id="hamburger" aria-label="Menú">
			<span></span><span></span><span></span>
		</button>
		</div>
	</div>
</header>

<!-- ═══════════════ CARRITO DRAWER ═══════════════ -->
<div class="cart-overlay" id="cartOverlay"></div>
	<aside class="cart-drawer" id="cartDrawer">
	<div class="cart-header">
		<h2>Tu pedido</h2>
		<button class="cart-close" id="cartClose">✕</button>
	</div>

	<div class="cart-body" id="cartBody">
		<div class="cart-empty" id="cartEmpty">
		<div class="cart-empty-icon">🛒</div>
		<p>Tu carrito está vacío</p>
		<a href="/productos" class="btn-primary" style="margin-top:1rem;">Ver productos</a>
		</div>
		<ul class="cart-list" id="cartList"></ul>
	</div>

	<div class="cart-footer" id="cartFooter" style="display:none">
		<div class="cart-total">
		<span>Total estimado</span>
		<strong id="cartTotal">$0</strong>
		</div>
		<p class="cart-disclaimer">* Los precios son orientativos. Confirmaremos por WhatsApp.</p>
		<button class="btn-wp cart-send" id="cartSend">
		<svg class="wp-icon" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
		Enviar pedido por WhatsApp
		</button>
		<button class="cart-vaciar" id="cartVaciar">Vaciar carrito</button>
	</div>
</aside>

<!-- ═══════════════ CONTENIDO ═══════════════ -->
<main>
	<slot />
</main>

<!-- ═══════════════ FOOTER ═══════════════ -->
<footer class="footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<div class="footer-logo">
				<img src="/logoDescartable.webp" alt="Logo" class="logo-img-sm" onerror="this.style.display='none'" />
				<div>
					<strong>El Mundo Del Descartable</strong>
					<span>Productos descartables por mayor y menor</span>
				</div>
			</div>
			<p>Calidad y variedad para tu negocio o evento. Envíos a todo el país.</p>
		</div>
		<div class="footer-links">
			<h4>Navegación</h4>
			<a href="/">Inicio</a>
			<a href="/productos">Productos</a>
			<a href="/#categorias">Categorías</a>
			<a href="/#contacto">Contacto</a>
		</div>
		<div class="footer-contact">
			<h4>Contacto</h4>
			<a href="https://wa.me/543572549909" target="_blank" rel="noopener">
				<svg class="wp-icon" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
				3572 549909
			</a>

			<a href="https://www.instagram.com/elmundodeldescartable/" target="_blank" rel="noopener">
				<svg class="ig-icon" viewBox="0 0 24 24"><path d="M7.75 2C4.574 2 2 4.574 2 7.75v8.5C2 19.426 4.574 22 7.75 22h8.5C19.426 22 22 19.426 22 16.25v-8.5C22 4.574 19.426 2 16.25 2h-8.5zm0 2h8.5C18.56 4 20 5.44 20 7.75v8.5C20 18.56 18.56 20 16.25 20h-8.5C5.44 20 4 18.56 4 16.25v-8.5C4 5.44 5.44 4 7.75 4zm8.75 1.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/></svg>
				@elmundodeldescartable
			</a>
		</div>
	</div>
	<div class="footer-bottom">
		<p>© 2026 El Mundo Del Descartable · Todos los derechos reservados</p>
	</div>
</footer>

<!-- Botón flotante WP -->
<a href="https://wa.me/543572549909" target="_blank" rel="noopener" class="wp-float" aria-label="WhatsApp">
	<svg viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

<style is:global>
	/* ---- Global ---- */
	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	:root {
		--blue:#1A6FC4; --blue-dark:#0f4f8f; --blue-light:#E8F4FD;
		--green:#2E8B22; --green-dark:#1e5e17; --green-light:#EBF5E8;
		--teal:#0F9E8A; --wp:#25D366; --wp-dark:#1aad55;
		--text-dark:#1a2332; --text-mid:#4a5568; --text-soft:#718096;
		--border:#e2ecf7; --bg:#F7FAFE; --white:#ffffff;
		--radius-sm:8px; --radius-md:12px; --radius-lg:18px; --radius-xl:24px;
		--shadow-sm:0 2px 8px rgba(0,0,0,.06); --shadow-md:0 4px 20px rgba(0,0,0,.1); --shadow-lg:0 8px 40px rgba(0,0,0,.14);
		--nav-h:68px; --font-head:'Nunito',sans-serif; --font-body:'Outfit',sans-serif;
	}
	html { scroll-behavior: smooth; }
	body { font-family: var(--font-body); background: var(--bg); color: var(--text-dark); line-height: 1.6; overflow-x: hidden; }
	img { max-width: 100%; display: block; }
	a { text-decoration: none; color: inherit; }
	button { font-family: var(--font-body); cursor: pointer; border: none; background: none; }
	.container { width: 100%; max-width: 1140px; margin: 0 auto; padding: 0 1.25rem; }
	.wp-icon { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }
	.ig-icon { width: 18px; height: 18px; fill: #E1306C; flex-shrink: 0;}

	.btn-wp {
		display: inline-flex; align-items: center; gap: 8px;
		background: var(--wp); color: #fff; border-radius: 50px;
		padding: 11px 24px; font-size: 14px; font-weight: 600;
		transition: background .2s, transform .15s; border: none; cursor: pointer;
	}
	.btn-wp:hover { background: var(--wp-dark); transform: translateY(-1px); }
	.btn-primary {
		display: inline-flex; align-items: center; gap: 8px;
		background: var(--blue); color: #fff; border-radius: 50px;
		padding: 11px 24px; font-size: 14px; font-weight: 600;
		transition: background .2s, transform .15s; border: none; cursor: pointer;
	}
	.btn-primary:hover { background: var(--blue-dark); transform: translateY(-1px); }
	.btn-outline {
		display: inline-flex; align-items: center; gap: 8px;
		background: transparent; color: var(--blue); border: 1.5px solid var(--blue);
		border-radius: 50px; padding: 10px 22px; font-size: 14px; font-weight: 600;
		transition: background .2s; cursor: pointer;
	}
	.btn-outline:hover { background: var(--blue); color: var(--bg);}

	/* ── NAVBAR ── */
	.navbar {
		position: sticky; top: 0; z-index: 200;
		background: var(--white); border-bottom: 1px solid var(--border);
		height: var(--nav-h);
	}
	.nav-inner {
		height: 100%; display: flex; align-items: center;
		justify-content: space-between; gap: 1rem;
	}
	.nav-logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
	.logo-img { height: 100px; width: auto; object-fit: contain; }
	.logo-fallback {
		display: none; width: 42px; height: 42px; border-radius: 50%;
		background: linear-gradient(135deg,var(--blue),var(--teal),var(--green));
		align-items: center; justify-content: center; font-size: 22px;
	}
	.logo-text { display: flex; flex-direction: column; line-height: 1.1; }
	.logo-main { font-family: var(--font-head); font-weight: 800; font-size: 20px; color: var(--blue); }
	.logo-sub  { font-family: var(--font-head); font-weight: 600; font-size: 18px; color: var(--green); }

	.nav-links { display: flex; gap: 1.8rem; align-items: center; }
	.nav-link { font-size: 14px; color: var(--text-mid); font-weight: 400; transition: color .2s; }
	.nav-link:hover { color: var(--blue); }

	.nav-actions { display: flex; align-items: center; gap: .75rem; }
	.nav-wp-btn {
		display: flex; align-items: center; gap: 7px;
		background: var(--wp); color: #fff; border-radius: 50px;
		padding: 8px 18px; font-size: 13px; font-weight: 600;
		transition: background .2s;
	}
	.nav-wp-btn:hover { background: var(--wp-dark); }
	.nav-wp-text { display: inline; }

	.cart-btn {
		position: relative; width: 42px; height: 42px; border-radius: 50%;
		border: 1.5px solid var(--border); display: flex; align-items: center;
		justify-content: center; color: var(--text-mid); transition: border-color .2s, color .2s;
	}
	.cart-btn svg { width: 20px; height: 20px; }
	.cart-btn:hover { border-color: var(--blue); color: var(--blue); }
	.cart-badge {
		position: absolute; top: -5px; right: -5px;
		background: var(--blue); color: #fff; font-size: 10px; font-weight: 700;
		width: 18px; height: 18px; border-radius: 50%; display: flex;
		align-items: center; justify-content: center; border: 2px solid #fff;
	}

	.hamburger {
		display: none; flex-direction: column; gap: 5px;
		width: 36px; height: 36px; align-items: center; justify-content: center;
	}
	.hamburger span { display: block; width: 22px; height: 2px; background: var(--text-dark); border-radius: 2px; transition: all .3s; }
	.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
	.hamburger.open span:nth-child(2) { opacity: 0; }
	.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

	/* ── CART DRAWER ── */
	.cart-overlay {
		display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45);
		z-index: 300; opacity: 0; transition: opacity .3s;
	}
	.cart-overlay.visible { display: block; opacity: 1; }

	.cart-drawer {
		position: fixed; top: 0; right: -420px; width: min(420px,100vw);
		height: 100vh; background: var(--white); z-index: 400;
		display: flex; flex-direction: column;
		box-shadow: var(--shadow-lg); transition: right .32s cubic-bezier(.4,0,.2,1);
	}
	.cart-drawer.open { right: 0; }

	.cart-header {
		display: flex; align-items: center; justify-content: space-between;
		padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border);
	}
	.cart-header h2 { font-family: var(--font-head); font-size: 1.2rem; font-weight: 800; }
	.cart-close {
		width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border);
		display: flex; align-items: center; justify-content: center;
		font-size: 14px; color: var(--text-soft); transition: background .2s;
	}
	.cart-close:hover { background: var(--bg); }

	.cart-body { flex: 1; overflow-y: auto; padding: 1rem 1.5rem; }

	.cart-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: .5rem; color: var(--text-soft); }
	.cart-empty-icon { font-size: 52px; margin-bottom: .5rem; }

	.cart-list { list-style: none; display: flex; flex-direction: column; gap: .75rem; }
	.cart-item {
		display: flex; gap: .75rem; align-items: flex-start;
		padding: .75rem; border: 1px solid var(--border); border-radius: var(--radius-md);
		background: var(--bg);
	}
	.cart-item-img {
		width: 56px; height: 56px; border-radius: var(--radius-sm); object-fit: cover;
		background: #e8f0fa; flex-shrink: 0;
	}
	.cart-item-info { flex: 1; min-width: 0; }
	.cart-item-name { font-weight: 600; font-size: 13px; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.cart-item-price { font-size: 13px; color: var(--blue); font-weight: 700; }
	.cart-item-controls { display: flex; align-items: center; gap: 6px; margin-top: 6px; }
	.qty-btn {
		width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--border);
		display: flex; align-items: center; justify-content: center;
		font-size: 14px; font-weight: 700; color: var(--text-mid);
		transition: background .15s; cursor: pointer;
	}
	.qty-btn:hover { background: var(--blue-light); border-color: var(--blue); color: var(--blue); }
	.qty-num { font-size: 14px; font-weight: 600; min-width: 20px; text-align: center; }
	.cart-item-del {
		width: 28px; height: 28px; border-radius: 50%; border: 1px solid #fecaca;
		display: flex; align-items: center; justify-content: center;
		font-size: 12px; color: #e53e3e; flex-shrink: 0; margin-top: 2px;
		transition: background .15s; cursor: pointer;
	}
	.cart-item-del:hover { background: #fff5f5; }

	.cart-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: .75rem; }
	.cart-total { display: flex; justify-content: space-between; align-items: center; font-size: 15px; }
	.cart-total strong { font-family: var(--font-head); font-weight: 800; font-size: 1.3rem; color: var(--blue); }
	.cart-disclaimer { font-size: 11px; color: var(--text-soft); }
	.cart-send { width: 100%; justify-content: center; font-size: 15px; padding: 13px; }
	.cart-vaciar { width: 100%; text-align: center; font-size: 12px; color: var(--text-soft); padding: .4rem; border-radius: 6px; transition: background .15s; }
	.cart-vaciar:hover { background: var(--bg); color: var(--text-mid); }

	/* ── FOOTER ── */
	.footer { background: #0f1f33; color: rgba(255,255,255,.75); padding: 3rem 0 0; }
	.footer-inner {
		display: grid; grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem; padding-bottom: 2.5rem;
	}
	.footer-brand p { font-size: 13px; color: rgba(255,255,255,.5); margin-top: .75rem; line-height: 1.6; }
	.footer-logo { display: flex; align-items: center; gap: 10px; margin-bottom: .75rem; }
	.footer-logo strong { display: block; font-family: var(--font-head); font-weight: 800; font-size: 15px; color: #fff; }
	.footer-logo span { font-size: 12px; color: rgba(255,255,255,.5); }
	.logo-img-sm { height: 100px; width: auto; object-fit: contain; }
	.footer-links, .footer-contact { display: flex; flex-direction: column; gap: .5rem; }
	.footer-links h4, .footer-contact h4 { font-family: var(--font-head); font-weight: 700; font-size: 13px; color: #fff; text-transform: uppercase; letter-spacing: .06em; margin-bottom: .25rem; }
	.footer-links a, .footer-contact a { font-size: 13px; transition: color .2s; display: flex; align-items: center; gap: 6px; }
	.footer-links a:hover, .footer-contact a:hover { color: #fff; }
	.footer-contact .wp-icon { width: 15px; height: 15px; fill: var(--wp); }
	.footer-bottom { border-top: 1px solid rgba(255,255,255,.1); padding: 1rem 1.25rem; text-align: center; font-size: 12px; color: rgba(255,255,255,.35); }

	/* ── WP FLOAT ── */
	.wp-float {
		position: fixed; bottom: 24px; right: 24px; z-index: 150;
		width: 56px; height: 56px; border-radius: 50%;
		background: var(--wp); display: flex; align-items: center; justify-content: center;
		box-shadow: 0 4px 16px rgba(37,211,102,.4); transition: transform .2s, background .2s;
	}
	.wp-float svg { width: 28px; height: 28px; }
	.wp-float:hover { transform: scale(1.08); background: var(--wp-dark); }

	/* ── RESPONSIVE ── */
	@media (max-width: 900px) {
		.nav-links { display: none; }
		.nav-links.mobile-open {
		display: flex; flex-direction: column; align-items: flex-start;
		position: absolute; top: var(--nav-h); left: 0; right: 0;
		background: var(--white); padding: 1rem 1.5rem 1.5rem;
		border-bottom: 1px solid var(--border); gap: 1rem; z-index: 199;
		}
		.nav-link { font-size: 16px; }
		.hamburger { display: flex; }
		.nav-wp-text { display: none; }
		.nav-wp-btn { padding: 8px 12px; }
		.footer-inner { grid-template-columns: 1fr 1fr; }
		.footer-brand { grid-column: 1 / -1; }
	}
	@media (max-width: 560px) {
		.logo-img { width: 80px; }
		.footer-inner { grid-template-columns: 1fr; }
		.wp-float { bottom: 16px; right: 16px; width: 50px; height: 50px; }
		.wp-float svg { width: 24px; height: 24px; }
	}
</style>

<script>
	const WP_NUMBER = "543572549909";

	function openWP(msg = "Hola! Quisiera consultar sobre sus productos descartables.") {
		window.open(`https://wa.me/${WP_NUMBER}?text=${encodeURIComponent(msg)}`, "_blank");
	}
	window.openWP = openWP;

	// ── Carrito logic ──
	function getItems() {
		try { return JSON.parse(localStorage.getItem("carrito") || "[]"); } catch { return []; }
	}
	function saveItems(items) {
		localStorage.setItem("carrito", JSON.stringify(items));
		renderCart();
	}

	function renderCart() {
		const items = getItems();
		const badge = document.getElementById("cartBadge");
		const list  = document.getElementById("cartList");
		const empty = document.getElementById("cartEmpty");
		const footer = document.getElementById("cartFooter");
		const totalEl = document.getElementById("cartTotal");

		const count = items.reduce((a, i) => a + i.cantidad, 0);
		if (badge) badge.textContent = count;

		if (!list) return;
		if (items.length === 0) {
		list.innerHTML = "";
		if (empty) empty.style.display = "flex";
		if (footer) footer.style.display = "none";
		return;
		}
		if (empty) empty.style.display = "none";
		if (footer) footer.style.display = "flex";

		list.innerHTML = items.map(i => `
		<li class="cart-item" data-id="${i.id}">
			<img class="cart-item-img" src="${i.imagen}" alt="${i.nombre}"
				onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 56 56%22><rect width=%2256%22 height=%2256%22 fill=%22%23e8f0fa%22/><text x=%2250%25%22 y=%2254%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-size=%2224%22>📦</text></svg>'" />
			<div class="cart-item-info">
			<div class="cart-item-name">${i.nombre}</div>
			<div class="cart-item-price">$${(i.precio * i.cantidad).toLocaleString("es-AR")}</div>
			<div class="cart-item-controls">
				<button class="qty-btn" onclick="cartCambiar(${i.id}, -1)">−</button>
				<span class="qty-num">${i.cantidad}</span>
				<button class="qty-btn" onclick="cartCambiar(${i.id}, 1)">+</button>
			</div>
			</div>
			<button class="cart-item-del" onclick="cartQuitar(${i.id})" title="Quitar">✕</button>
		</li>
		`).join("");

		const total = items.reduce((a, i) => a + i.precio * i.cantidad, 0);
		if (totalEl) totalEl.textContent = "$" + total.toLocaleString("es-AR");
	}

	window.cartAgregar = function(producto) {
		const items = getItems();
		const idx = items.findIndex(i => i.id === producto.id);
		if (idx >= 0) items[idx].cantidad += 1;
		else items.push({ ...producto, cantidad: 1 });
		saveItems(items);
		openCartDrawer();
		showToast(`${producto.nombre} agregado al carrito`);
	};

	window.cartQuitar = function(id) {
		saveItems(getItems().filter(i => i.id !== id));
	};

	window.cartCambiar = function(id, delta) {
		const items = getItems();
		const idx = items.findIndex(i => i.id === id);
		if (idx < 0) return;
		items[idx].cantidad = Math.max(1, items[idx].cantidad + delta);
		saveItems(items);
	};

	function openCartDrawer() {
		document.getElementById("cartDrawer")?.classList.add("open");
		document.getElementById("cartOverlay")?.classList.add("visible");
		document.body.style.overflow = "hidden";
	}
	function closeCartDrawer() {
		document.getElementById("cartDrawer")?.classList.remove("open");
		document.getElementById("cartOverlay")?.classList.remove("visible");
		document.body.style.overflow = "";
	}

	// Toast
	function showToast(msg) {
		let t = document.getElementById("toastEl");
		if (!t) {
		t = document.createElement("div");
		t.id = "toastEl";
		t.style.cssText = "position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#1a2332;color:#fff;padding:10px 20px;border-radius:50px;font-size:13px;font-weight:600;z-index:9999;opacity:0;transition:opacity .3s;white-space:nowrap;pointer-events:none;";
		document.body.appendChild(t);
		}
		t.textContent = msg;
		t.style.opacity = "1";
		clearTimeout(t._t);
		t._t = setTimeout(() => { t.style.opacity = "0"; }, 2000);
	}

	document.getElementById("cartBtn")?.addEventListener("click", openCartDrawer);
	document.getElementById("cartClose")?.addEventListener("click", closeCartDrawer);
	document.getElementById("cartOverlay")?.addEventListener("click", closeCartDrawer);

	document.getElementById("cartSend")?.addEventListener("click", () => {
		const items = getItems();
		if (!items.length) return;
		const lineas = items.map(i => `▪ ${i.nombre} x${i.cantidad} — $${(i.precio * i.cantidad).toLocaleString("es-AR")}`).join("\n");
		const total = items.reduce((a, i) => a + i.precio * i.cantidad, 0);
		const msg = `¡Hola! Quiero hacer el siguiente pedido:\n\n${lineas}\n\n*Total estimado: $${total.toLocaleString("es-AR")}*\n\n¿Pueden confirmar disponibilidad y formas de pago? ¡Gracias!`;
		window.open(`https://wa.me/${WP_NUMBER}?text=${encodeURIComponent(msg)}`, "_blank");
	});

	document.getElementById("cartVaciar")?.addEventListener("click", () => {
		if (confirm("¿Vaciar el carrito?")) saveItems([]);
	});

	// Hamburger
	document.getElementById("hamburger")?.addEventListener("click", function() {
		this.classList.toggle("open");
		document.getElementById("navLinks")?.classList.toggle("mobile-open");
	});

	// Navbar shadow on scroll
	window.addEventListener("scroll", () => {
		const nav = document.getElementById("navbar");
		if (nav) nav.style.boxShadow = window.scrollY > 10 ? "0 2px 20px rgba(0,0,0,.08)" : "";
	});

	// Init
	renderCart();
	window.addEventListener("storage", renderCart);
</script>

</body>
</html>