---
import Layout from '../layouts/Layout.astro';
import { productos, categorias } from '../data/productos.js';

const destacados = productos.slice(0, 8);

const resenas = [
	{ nombre: "María González", negocio: "Restaurante El Fogón", texto: "Excelente calidad y atención. Los vasos y platos son perfectos para mi restaurante. Siempre me responden rápido por WhatsApp.", estrellas: 5, inicial: "M" },
	{ nombre: "Carlos Pérez", negocio: "Catering Eventos", texto: "Llevo más de 2 años comprando acá. Los precios por mayor son imbatibles y el packaging para delivery es de primera.", estrellas: 5, inicial: "C" },
	{ nombre: "Laura Sánchez", negocio: "Kiosco La Esquina", texto: "Siempre tienen stock de lo que necesito. Las bolsas y cubiertos son excelentes. Muy recomendable para negocios chicos.", estrellas: 5, inicial: "L" },
	{ nombre: "Diego Romero", negocio: "Pizzería Don Diego", texto: "El packaging para pizza y delivery es de muy buena calidad. Lo mejor es que se adaptan a las cantidades que pido.", estrellas: 4, inicial: "D" },
	{ nombre: "Ana Torres", negocio: "Salón de fiestas", texto: "Compro todo lo de descartable para mis eventos acá. Precios accesibles, buena calidad y envíos puntuales.", estrellas: 5, inicial: "A" },
	{ nombre: "Martín López", negocio: "Food Truck", texto: "Increíble variedad. En un solo pedido consigo todo: cajas, vasos, cubiertos y servilletas. Muy cómodo trabajar así.", estrellas: 5, inicial: "M" },
];

const galeria = [
	{ emoji: "🥤", label: "Vasos y bebidas", color: "#dbeafe" },
	{ emoji: "🍽️", label: "Platos y bandejas", color: "#dcfce7" },
	{ emoji: "📦", label: "Packaging delivery", color: "#fef3c7" },
	{ emoji: "🛍️", label: "Bolsas y packaging", color: "#fce7f3" },
	{ emoji: "🍴", label: "Cubiertos descartables", color: "#ede9fe" },
	{ emoji: "🧻", label: "Servilletas y papel", color: "#e0f2fe" },
];
---

<Layout title="El Mundo del Descartable | Productos Plásticos y Descartables al Mejor Precio" description="El Mundo Del Descartable — Productos descartables por mayor y menor. Vasos, platos, cubiertos, bolsas y más. Calidad garantizada con los mejores precios del mercado. Envíos a todo el país. Atención personalizada por WhatsApp. ¡Compra ahora!">

	<!-- ══════════ HERO ══════════ -->
	<section class="hero">
		<div class="hero-bg"></div>
		<div class="container hero-inner">
			<div class="hero-content">
			<div class="hero-badge">🛒 Venta por mayor y menor</div>
			<h1>
				Todo en descartables<br />
				para tu <em>negocio o evento</em>
			</h1>
			<p>Vasos, platos, cubiertos, bolsas, packaging y más. Calidad garantizada con los mejores precios del mercado.</p>
			<div class="hero-btns">
				<a href="/productos" class="btn-primary hero-cta">
				<svg style="width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round" viewBox="0 0 24 24">
					<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
					<path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
				</svg>
				Ver productos
				</a>
				<button class="btn-outline" onclick="openWP()">Consultar por WP</button>
			</div>
			</div>
			<div class="hero-visual">
			<div class="hero-blob">
				<div class="blob-inner">
				<span class="blob-emoji">🌍</span>
				<div class="blob-stats">
					<div class="blob-stat"><strong>+500</strong><span>Productos</span></div>
					<div class="blob-stat"><strong>Mayor</strong><span>y menor</span></div>
					<div class="blob-stat"><strong>Envíos</strong><span>al país</span></div>
				</div>
				</div>
			</div>
			</div>
		</div>
	</section>

	<!-- ══════════ STATS BAR ══════════ -->
	<div class="stats-bar">
		<div class="container stats-inner">
			<div class="stat"><span class="stat-n">+500</span><span class="stat-l">Productos disponibles</span></div>
			<div class="stat-div"></div>
			<div class="stat"><span class="stat-n">Mayor y menor</span><span class="stat-l">Modalidad de venta</span></div>
			<div class="stat-div"></div>
			<div class="stat"><span class="stat-n">Envíos</span><span class="stat-l">A todo el país</span></div>
			<div class="stat-div"></div>
			<div class="stat"><span class="stat-n">Atención</span><span class="stat-l">Personalizada por WP</span></div>
		</div>
	</div>

	<!-- ══════════ CATEGORÍAS ══════════ -->
	<section class="section" id="categorias">
		<div class="container">
			<div class="section-header">
			<h2>Nuestras <span class="accent">categorías</span></h2>
			<p>Encontrá todo lo que necesitás para tu negocio, evento o uso diario</p>
			</div>
			<div class="cat-grid">
			{categorias.filter(c => c !== "Todas").map(cat => {
				const emojis = {
					"Vasos": "🥤",
					"Platos y bandejas": "🍽️",
					"Cubiertos": "🍴",
					"Bolsas": "🛍️",
					"Packaging": "📦",
					"Higiene": "🧴",
					"Servilletas y papel": "🧻",
					"Eventos": "🎉"
				};
				const count = productos.filter(p => p.categoria === cat).length;
				return (
				<a href={`/productos?cat=${encodeURIComponent(cat)}`} class="cat-card">
					<span class="cat-icon">{emojis[cat] || "📦"}</span>
					<span class="cat-name">{cat}</span>
					<span class="cat-count">{count} producto{count !== 1 ? "s" : ""}</span>
				</a>
				);
			})}
			</div>
		</div>
	</section>

	<!-- ══════════ PRODUCTOS DESTACADOS ══════════ -->
	<section class="section section-alt">
		<div class="container">
			<div class="section-header" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
			<div>
				<h2>Productos <span class="accent">destacados</span></h2>
				<p>Los más consultados por nuestros clientes</p>
			</div>
			<a href="/productos" class="btn-outline">Ver todos →</a>
			</div>
			<div class="prod-grid">
			{destacados.map(p => (
				<div class="prod-card">
				<div class="prod-img-wrap">
					<img
					src={p.imagen}
					alt={p.nombre}
					class="prod-img"
					onerror="this.parentElement.innerHTML='<div class=\'prod-img-fallback\'>' + (({'Vasos':'🥤','Platos y bandejas':'🍽️','Cubiertos':'🍴','Bolsas':'🛍️','Packaging':'📦','Higiene':'🧴','Servilletas y papel':'🧻'})[this.alt?.split(' ')[0]] || '📦') + '</div>'"
					/>
				</div>
				<div class="prod-body">
					<span class="prod-cat">{p.categoria}</span>
					<h3 class="prod-name">{p.nombre}</h3>
					<p class="prod-desc">{p.descripcion}</p>
					<div class="prod-footer">
					<div class="prod-price">
						${p.precio.toLocaleString("es-AR")}
						<small>{p.unidad}</small>
					</div>
					<button
						class="btn-add"
						onclick={`cartAgregar(${JSON.stringify(p)})`}
					>
						+ Agregar
					</button>
					</div>
				</div>
				</div>
			))}
			</div>
		</div>
	</section>

	<!-- ══════════ GALERÍA ══════════ -->
	<section class="section" id="galeria">
		<div class="container">
			<div class="section-header">
			<h2>Nuestros <span class="accent">rubros</span></h2>
			<p>Una amplia variedad para cubrir todas tus necesidades</p>
			</div>
			<div class="galeria-grid">
			{galeria.map(g => (
				<div class="galeria-card" style={`background:${g.color}`}>
				<span class="galeria-emoji">{g.emoji}</span>
				<span class="galeria-label">{g.label}</span>
				</div>
			))}
			</div>
		</div>
	</section>

	<!-- ══════════ POR QUÉ ELEGIRNOS ══════════ -->
	<section class="section why-section">
		<div class="container">
			<div class="section-header" style="text-align:center">
			<h2>¿Por qué <span class="accent">elegirnos?</span></h2>
			<p>Miles de clientes confían en nosotros para sus negocios y eventos</p>
			</div>
			<div class="why-grid">
			<div class="why-card">
				<div class="why-icon" style="background:#dbeafe">🚀</div>
				<div><h4>Envíos rápidos</h4><p>Despachamos en el día o siguiente hábil. Llegamos a todo el país.</p></div>
			</div>
			<div class="why-card">
				<div class="why-icon" style="background:#dcfce7">💰</div>
				<div><h4>Precios competitivos</h4><p>Los mejores precios del mercado, tanto por mayor como por menor.</p></div>
			</div>
			<div class="why-card">
				<div class="why-icon" style="background:#fef3c7">📦</div>
				<div><h4>Gran variedad</h4><p>Más de 500 productos disponibles en stock permanente.</p></div>
			</div>
			<div class="why-card">
				<div class="why-icon" style="background:#fce7f3">💬</div>
				<div><h4>Atención personalizada</h4><p>Te asesoramos por WhatsApp para encontrar lo que necesitás.</p></div>
			</div>
			</div>
		</div>
	</section>

	<!-- ══════════ RESEÑAS ══════════ -->
	<section class="section section-alt" id="resenas">
		<div class="container">
			<div class="section-header" style="text-align:center">
			<h2>Lo que dicen nuestros <span class="accent">clientes</span></h2>
			<p>Más de 1000 clientes satisfechos en toda la región</p>
			</div>
			<div class="resenas-grid">
			{resenas.map(r => (
				<div class="resena-card">
				<div class="resena-header">
					<div class="resena-avatar">{r.inicial}</div>
					<div>
					<strong class="resena-nombre">{r.nombre}</strong>
					<span class="resena-negocio">{r.negocio}</span>
					</div>
				</div>
				<div class="resena-estrellas">{"★".repeat(r.estrellas)}{"☆".repeat(5 - r.estrellas)}</div>
				<p class="resena-texto">"{r.texto}"</p>
				</div>
			))}
			</div>
		</div>
	</section>

	<!-- ══════════ CTA FINAL ══════════ -->
	<section class="cta-final" id="contacto">
		<div class="container cta-inner">
			<div class="cta-text">
				<h2>¿Necesitás presupuesto?</h2>
				<p>Escribinos por WhatsApp y te respondemos al instante con precios y disponibilidad. También podés armar tu pedido directo desde el carrito.</p>
			</div>
			<div class="cta-btns">
				<button class="btn-wp" onclick="openWP()" style="font-size:15px;padding:14px 28px">
					<svg class="wp-icon" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
					Escribinos ahora
				</button>
				<a href="/productos" class="btn-outline" style="color:#fff;border-color:rgba(255,255,255,.5)">Ver catálogo</a>
			</div>
		</div>
	</section>

	<style>
		/* ── HERO ── */
		.hero { position:relative; padding:5rem 0 4rem; overflow:hidden; }
		.hero-bg {
			position:absolute; inset:0;
			background: linear-gradient(160deg,#EAF4FF 0%,#f0f9eb 60%,var(--bg) 100%);
			z-index:0;
		}
		.hero-inner { position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:center; }
		.hero-badge {
			display:inline-block; background:var(--blue-light); color:var(--blue);
			border-radius:50px; padding:5px 16px; font-size:13px; font-weight:600;
			margin-bottom:1.2rem; border:1px solid #c0dcf7;
		}
		.hero h1 {
			font-family:var(--font-head); font-weight:900;
			font-size:clamp(2rem,4.5vw,3.2rem); line-height:1.12; margin-bottom:1rem;
		}
		.hero h1 em { font-style:normal; color:var(--blue); }
		.hero p { font-size:16px; color:var(--text-mid); max-width:480px; margin-bottom:2rem; font-weight:300; }
		.hero-btns { display:flex; gap:12px; flex-wrap:wrap; }
		.hero-cta { font-size:15px; padding:13px 26px; }
		.hero-visual { display:flex; justify-content:center; align-items:center; }
		.hero-blob {
			width:320px; height:320px; border-radius:60% 40% 55% 45% / 50% 60% 40% 50%;
			background:linear-gradient(135deg,var(--blue),var(--teal),var(--green));
			display:flex; align-items:center; justify-content:center;
			animation: morphBlob 8s ease-in-out infinite;
		}
		@keyframes morphBlob {
			0%,100% { border-radius:60% 40% 55% 45%/50% 60% 40% 50%; }
			33% { border-radius:45% 55% 40% 60%/60% 40% 55% 45%; }
			66% { border-radius:55% 45% 60% 40%/45% 55% 50% 50%; }
		}
		.blob-inner { display:flex; flex-direction:column; align-items:center; gap:.75rem; }
		.blob-emoji { font-size:72px; }
		.blob-stats { display:flex; gap:1rem; }
		.blob-stat { text-align:center; color:#fff; }
		.blob-stat strong { display:block; font-family:var(--font-head); font-weight:800; font-size:16px; }
		.blob-stat span { font-size:11px; opacity:.8; }

		/* ── STATS ── */
		.stats-bar { background:var(--blue); color:#fff; }
		.stats-inner { display:flex; align-items:center; justify-content:center; gap:0; flex-wrap:wrap; }
		.stat { display:flex; flex-direction:column; align-items:center; padding:1.1rem 2.5rem; }
		.stat-n { font-family:var(--font-head); font-weight:800; font-size:1.2rem; }
		.stat-l { font-size:12px; opacity:.8; margin-top:2px; }
		.stat-div { width:1px; height:40px; background:rgba(255,255,255,.25); flex-shrink:0; }

		/* ── SECTIONS ── */
		.section { padding:4rem 0; }
		.section-alt { background:#f0f7ff; }
		.section-header { margin-bottom:2rem; }
		.section-header h2 { font-family:var(--font-head); font-weight:800; font-size:clamp(1.6rem,3vw,2.1rem); margin-bottom:.3rem; }
		.section-header p { color:var(--text-soft); font-size:15px; font-weight:300; }
		.accent { color:var(--blue); }

		/* ── CATEGORÍAS ── */
		.cat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:14px; }
		.cat-card {
			background:var(--white); border-radius:var(--radius-lg); border:1.5px solid var(--border);
			padding:1.5rem 1rem; text-align:center; display:flex; flex-direction:column; align-items:center; gap:.5rem;
			transition:transform .2s,border-color .2s,box-shadow .2s; cursor:pointer;
		}
		.cat-card:hover { transform:translateY(-4px); border-color:var(--blue); box-shadow:0 8px 24px rgba(26,111,196,.1); }
		.cat-icon { font-size:36px; }
		.cat-name { font-weight:600; font-size:14px; }
		.cat-count { font-size:12px; color:var(--text-soft); }

		/* ── PRODUCTOS ── */
		.prod-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
		.prod-card {
			background:var(--white); border-radius:var(--radius-lg); border:1.5px solid var(--border);
			overflow:hidden; transition:transform .2s,box-shadow .2s; display:flex; flex-direction:column;
		}
		.prod-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-md); }
		.prod-img-wrap { height:160px; overflow:hidden; background:var(--bg); display:flex; align-items:center; justify-content:center; }
		.prod-img { width:100%; height:100%; object-fit:cover; }
		.prod-img-fallback { font-size:64px; }
		.prod-body { padding:1rem 1.1rem; flex:1; display:flex; flex-direction:column; }
		.prod-cat { font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--blue); font-weight:600; }
		.prod-name { font-family:var(--font-head); font-weight:700; font-size:15px; margin:.25rem 0 .4rem; }
		.prod-desc { font-size:12px; color:var(--text-soft); flex:1; line-height:1.5; margin-bottom:.8rem; }
		.prod-footer { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-top:auto; }
		.prod-price { font-family:var(--font-head); font-weight:800; font-size:18px; color:var(--blue); }
		.prod-price small { display:block; font-size:10px; color:var(--text-soft); font-weight:400; font-family:var(--font-body); }
		.btn-add {
			background:var(--blue); color:#fff; border-radius:50px; padding:8px 16px;
			font-size:12px; font-weight:600; white-space:nowrap; transition:background .2s,transform .15s;
		}
		.btn-add:hover { background:var(--blue-dark); transform:scale(1.04); }

		/* ── GALERÍA ── */
		.galeria-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:14px; }
		.galeria-card {
			border-radius:var(--radius-lg); padding:2rem 1rem;
			display:flex; flex-direction:column; align-items:center; gap:.75rem;
			transition:transform .2s;
		}
		.galeria-card:hover { transform:translateY(-3px); }
		.galeria-emoji { font-size:40px; }
		.galeria-label { font-weight:600; font-size:13px; text-align:center; color:var(--text-dark); }

		/* ── WHY ── */
		.why-section { background:var(--green-light); }
		.why-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; margin-top:1rem; }
		.why-card {
			background:var(--white); border-radius:var(--radius-lg); border:1.5px solid #d4edca;
			padding:1.4rem 1.2rem; display:flex; align-items:flex-start; gap:12px;
		}
		.why-icon { width:42px; height:42px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
		.why-card h4 { font-weight:700; font-size:14px; margin-bottom:4px; }
		.why-card p { font-size:12px; color:var(--text-soft); line-height:1.5; }

		/* ── RESEÑAS ── */
		.resenas-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:18px; }
		.resena-card {
			background:var(--white); border-radius:var(--radius-lg); border:1.5px solid var(--border);
			padding:1.4rem; display:flex; flex-direction:column; gap:.75rem;
			transition:box-shadow .2s;
		}
		.resena-card:hover { box-shadow:var(--shadow-sm); }
		.resena-header { display:flex; align-items:center; gap:12px; }
		.resena-avatar {
			width:42px; height:42px; border-radius:50%;
			background:linear-gradient(135deg,var(--blue),var(--teal));
			display:flex; align-items:center; justify-content:center;
			font-family:var(--font-head); font-weight:800; font-size:16px; color:#fff; flex-shrink:0;
		}
		.resena-nombre { display:block; font-weight:700; font-size:14px; }
		.resena-negocio { display:block; font-size:12px; color:var(--text-soft); }
		.resena-estrellas { color:#f59e0b; font-size:16px; letter-spacing:1px; }
		.resena-texto { font-size:13px; color:var(--text-mid); line-height:1.6; font-style:italic; }

		/* ── CTA FINAL ── */
		.cta-final { background:linear-gradient(135deg,var(--blue) 0%,var(--teal) 100%); padding:4rem 0; }
		.cta-inner { display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap; }
		.cta-text h2 { font-family:var(--font-head); font-weight:800; font-size:clamp(1.6rem,3vw,2.2rem); color:#fff; margin-bottom:.75rem; }
		.cta-text p { color:rgba(255,255,255,.8); font-size:15px; font-weight:300; max-width:500px; }
